    def next_word(self):
        remaining = [w for w in self.vocab_list if w[0] not in self.study_data["vocab_mastered"]]
        if not remaining:
            messagebox.showinfo("完成", "恭喜！你已掌握全部核心词汇！")
            return
        self.current_word = random.choice(remaining)
        self.word_label.config(text=self.current_word[0])
        self.meaning_label.config(text="???")

    def show_meaning(self):
        if self.current_word:
            self.meaning_label.config(text=self.current_word[1])

    def mark_mastered(self):
        if self.current_word and self.current_word[0] not in self.study_data["vocab_mastered"]:
            # 记录学习日期，用于艾宾浩斯
            self.study_data["vocab_mastered"][self.current_word[0]] = datetime.now().date()
            mastered_count = len(self.study_data["vocab_mastered"])
            self.vocab_progress.config(text=f"进度: {mastered_count} / {self.vocab_total}")
            self.update_vocab_chart()
            self.next_word()

    def speak_word(self):
        if self.current_word and HAS_SPEECH:
            engine.say(self.current_word[0])
            engine.runAndWait()

    def update_vocab_chart(self):
        self.vocab_fig.clear()
        ax = self.vocab_fig.add_subplot(111)
        mastered = len(self.study_data["vocab_mastered"])
        remaining = self.vocab_total - mastered
        ax.pie([mastered, remaining], labels=["已掌握", "未学习"],
               autopct="%1.1f%%", colors=["#10b981", "#e5e7eb"], startangle=90)
        ax.set_title("词汇掌握度进度")
        self.vocab_canvas.draw()

