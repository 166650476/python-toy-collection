        self.review_stats = tk.Label(left, text="", font=("微软雅黑", 10), fg="#666")
        self.review_stats.pack(pady=10)

        # 右侧遗忘曲线图
        self.review_fig = plt.Figure(figsize=(6, 5), dpi=100)
        self.review_canvas = FigureCanvasTkAgg(self.review_fig, master=page)
        self.review_canvas.get_tk_widget().pack(side="right", padx=10, pady=10)
        
        self.today_review_words = []
        self.refresh_review()
        self.draw_forgetting_curve()

    def refresh_review(self):
        today = datetime.now().date()
        self.today_review_words = []

        for word, learn_date in self.study_data["vocab_mastered"].items():
            days_passed = (today - learn_date).days
            # 判断是否在复习节点
            for interval in self.review_intervals:
                if days_passed == interval:
                    self.today_review_words.append((word, f"第{interval}天复习"))
                    break

        self.review_listbox.delete(0, tk.END)
        for word, tip in self.today_review_words:
            self.review_listbox.insert(tk.END, f"{word}  -  {tip}")

        self.review_stats.config(text=f"今日待复习：{len(self.today_review_words)} 个单词")

    def mark_reviewed(self):
        sel = self.review_listbox.curselection()
        if not sel:
            messagebox.showwarning("提示", "请先选择要标记的单词！")
            return
        idx = sel[0]
        self.review_listbox.delete(idx)
        self.today_review_words.pop(idx)
        self.review_stats.config(text=f"今日待复习：{len(self.today_review_words)} 个单词")

    def draw_forgetting_curve(self):
        self.review_fig.clear()
        ax = self.review_fig.add_subplot(111)
        days = np.arange(0, 30, 0.5)
        # 艾宾浩斯遗忘曲线公式：记忆留存率 = 100 * 1.84 / (1 + 1.25 * x^0.8)
        retention = 100 * 1.84 / (1 + 1.25 * (days ** 0.8))

        ax.plot(days, retention, color="#1a56db", linewidth=2, label="记忆留存率")
        
        # 标记复习节点
        for d in self.review_intervals:
            r = 100 * 1.84 / (1 + 1.25 * (d ** 0.8))
            ax.scatter(d, r, color="#ef4444", s=60, zorder=5)
            ax.text(d+0.5, r+2, f"第{d}天", fontsize=9)

        ax.set_xlabel("天数")
        ax.set_ylabel("记忆留存率(%)")
        ax.set_title("艾宾浩斯遗忘曲线 & 复习节点")
        ax.legend()
        ax.grid(alpha=0.3)
        self.review_canvas.draw()

