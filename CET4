        self.analysis_canvas.get_tk_widget().pack(side="right", padx=10, pady=10)
        self.refresh_stats()

    def refresh_stats(self):
        vocab_rate = len(self.study_data["vocab_mastered"]) / self.vocab_total * 100 if self.vocab_total > 0 else 0
        listen_rate = self.listen_correct / self.listen_total * 100 if self.listen_total > 0 else 60
        read_rate = self.read_correct / self.read_total * 100 if self.read_total > 0 else 60
        writing_rate = 70

        latest_exam = self.study_data["exam_scores"][-1] if self.study_data["exam_scores"] else 0

        stats = f"""
【学习进度统计】

词汇掌握度：{vocab_rate:.1f}%
已掌握单词：{len(self.study_data['vocab_mastered'])} / {self.vocab_total}

听力正确率：{listen_rate:.1f}%
答对：{self.listen_correct} / {self.listen_total} 题

阅读正确率：{read_rate:.1f}%
答对：{self.read_correct} / {self.read_total} 题

写作参考分：{writing_rate} 分

最近模考得分：{latest_exam:.1f} 分

综合测评得分：
{(vocab_rate*0.3 + listen_rate*0.25 + read_rate*0.25 + writing_rate*0.2):.1f} 分
"""
        self.stats_text.delete("1.0", "end")
        self.stats_text.insert("end", stats)

        # 雷达图
        self.analysis_fig.clear()
        ax = self.analysis_fig.add_subplot(111, polar=True)
        categories = ["词汇", "听力", "阅读", "写作"]
        scores = [vocab_rate, listen_rate, read_rate, writing_rate]
        scores += scores[:1]
        angles = np.linspace(0, 2*np.pi, len(categories), endpoint=False)
        angles = np.append(angles, angles[0])

        ax.plot(angles, scores, 'o-', color="#1a56db", linewidth=2)
        ax.fill(angles, scores, alpha=0.25, color="#1a56db")
        ax.set_xticks(angles[:-1])
        ax.set_xticklabels(categories)
        ax.set_ylim(0, 100)
        ax.set_title("四级能力雷达图", pad=15, fontsize=12)
        self.analysis_canvas.draw()


