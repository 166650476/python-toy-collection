    def load_section(self, section):
        self.current_section = section
        self.current_q = 0
        self.load_exam_question()

    def load_exam_question(self):
        q = self.exam_data[self.current_section]["questions"][self.current_q]
        self.exam_q_label.config(text=q["q"])
        for i, opt in enumerate(q["options"]):
            self.exam_opts[i].config(text=opt)
        # 回显已选答案
        key = f"{self.current_section}_{self.current_q}"
        if key in self.exam_answers:
            self.exam_var.set(self.exam_answers[key])
        else:
            self.exam_var.set("")

    def save_answer(self):
        if self.exam_var.get():
            key = f"{self.current_section}_{self.current_q}"
            self.exam_answers[key] = self.exam_var.get()

    def prev_exam_q(self):
        self.save_answer()
        if self.current_q > 0:
            self.current_q -= 1
            self.load_exam_question()

    def next_exam_q(self):
        self.save_answer()
        total = self.exam_data[self.current_section]["total"]
        if self.current_q < total - 1:
            self.current_q += 1
            self.load_exam_question()
        else:
            messagebox.showinfo("提示", "本部分已完成，可切换其他部分或交卷")

    def submit_exam(self):
        self.save_answer()
        listen_correct = 0
        read_correct = 0
        write_score = 0

        # 听力算分
        for i in range(self.exam_data["听力"]["total"]):
            key = f"听力_{i}"
            if key in self.exam_answers and self.exam_answers[key] == self.exam_data["听力"]["questions"][i]["answer"]:
                listen_correct += 1
        listen_score = listen_correct / self.exam_data["听力"]["total"] * self.exam_data["听力"]["score"]

        # 阅读算分
        for i in range(self.exam_data["阅读"]["total"]):
            key = f"阅读_{i}"
            if key in self.exam_answers and self.exam_answers[key] == self.exam_data["阅读"]["questions"][i]["answer"]:
                read_correct += 1
        read_score = read_correct / self.exam_data["阅读"]["total"] * self.exam_data["阅读"]["score"]

        # 写作翻译算分
        write_ans = self.exam_answers.get("写作翻译_0", "D")
        score_map = {"A": 190, "B": 160, "C": 130, "D": 90}
        write_score = score_map.get(write_ans, 90)

        total_score = listen_score + read_score + write_score
        passed = "✅ 已过线" if total_score >= 425 else "❌ 未过线"

        self.exam_result.config(text=f"总分：{total_score:.1f} 分\n{passed}")
        self.study_data["exam_scores"].append(total_score)
        self.draw_exam_chart(listen_score, read_score, write_score)

    def draw_exam_chart(self, listen, read, write):
        self.exam_fig.clear()
        ax = self.exam_fig.add_subplot(111)
        sections = ["听力", "阅读", "写作翻译"]
        scores = [listen, read, write]
        colors = ["#3b82f6", "#10b981", "#f59e0b"]
        bars = ax.bar(sections, scores, color=colors, width=0.6)
        for bar, val in zip(bars, scores):
            ax.text(bar.get_x()+bar.get_width()/2, bar.get_height()+5, f"{val:.1f}", ha="center")
        
        ax.axhline(425/3, ls="--", color="gray", label="单部分及格线")
        ax.set_ylabel("分数")
        ax.set_title("四级模考各部分得分")
        ax.legend()
        ax.grid(axis="y", alpha=0.3)
        self.exam_canvas.draw()

