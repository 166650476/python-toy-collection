        weak_list = ["听力", "阅读", "写作", "词汇"]
        for w in weak_list:
            tk.Radiobutton(left, text=w, variable=self.weak_var, value=w).pack(anchor="w")

        tk.Button(left, text="生成学习计划", command=self.generate_plan, width=18, bg="#1a56db", fg="white").pack(pady=15)

        self.plan_text = tk.Text(left, width=40, height=22, font=("微软雅黑", 10))
        self.plan_text.pack()

        # 右侧时间分配饼图
        self.plan_fig = plt.Figure(figsize=(5, 5), dpi=100)
        self.plan_canvas = FigureCanvasTkAgg(self.plan_fig, master=page)
        self.plan_canvas.get_tk_widget().pack(side="right", padx=10, pady=10)
        self.generate_plan()

    def generate_plan(self):
        try:
            days = int(self.days_entry.get())
            hours = float(self.hours_entry.get())
            weak = self.weak_var.get()

            # 基础时间分配
            base_time = {
                "词汇": 0.3,
                "听力": 0.25,
                "阅读": 0.25,
                "写作": 0.2
            }
            # 薄弱项加权重
            base_time[weak] += 0.1
            total = sum(base_time.values())
            time_dist = {k: v/total * hours for k, v in base_time.items()}

            plan = f"""【四级备考 {days} 天学习计划】
每日学习时长：{hours} 小时
薄弱项强化：{weak}

━━━━━━━━━━━━━━━━
每日时间分配：
"""
            for k, v in time_dist.items():
                plan += f"  {k}：{v:.1f} 小时\n"

            plan += f"""
━━━━━━━━━━━━━━━━
阶段规划：

【基础阶段 第1-{days//3}天】
• 背完核心高频词汇
• 精听真题对话，积累场景词
• 每天1篇仔细阅读，分析长难句

【强化阶段 第{days//3+1}-{days*2//3}天】
• 二刷词汇，重点记生词
• 整套听力训练，总结错题
• 阅读提速，学习解题技巧
• 每周写2篇作文，背模板

【冲刺阶段 第{days*2//3+1}-{days}天】
• 整套真题模考，掐时间
• 复习错题本
• 背诵作文万能句型
• 调整作息，保持状态
"""
            self.plan_text.delete("1.0", "end")
            self.plan_text.insert("end", plan)

            # 画时间分配饼图
            self.plan_fig.clear()
            ax = self.plan_fig.add_subplot(111)
            ax.pie(time_dist.values(), labels=time_dist.keys(),
                   autopct="%1.1f%%", colors=["#3b82f6", "#10b981", "#f59e0b", "#ef4444"], startangle=90)
            ax.set_title("每日学习时间分配")
            self.plan_canvas.draw()

        except ValueError:
            messagebox.showerror("错误", "请输入有效数字！")

